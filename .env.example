# Database — matches compose.yaml (npm run db:setup starts it)
DATABASE_URL=postgresql://postgres:devpassword@localhost:5434/inbox_classifier

# Keep application secrets server-side. Never expose these through Vite.
SESSION_SECRET=replace-with-a-long-random-value

# Local preview mode. Set to false only after live Gmail + classifier services
# are configured and the OAuth callback is available.
INBOX_CLASSIFIER_DEMO_MODE=true

# Google Cloud OAuth 2.0 web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/api/account/callback

# Where the browser lands after Google sign-in (frontend origin).
APP_URL=http://localhost:5173

# TypeSafe classifier service
TYPESAFE_API_URL=
TYPESAFE_API_KEY=
TYPESAFE_MODEL=